<Page x:Class="AdminPanelElectroShop.Views.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdminPanelElectroShop.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StatisticsPage">
    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="📊 Статистика продаж" 
                       FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Карточки со статистикой -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,15" Width="200">
                    <StackPanel>
                        <TextBlock Text="👥" FontSize="28"/>
                        <TextBlock Text="Пользователей" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="TotalUsersText" Text="0" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,15" Width="200">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="28"/>
                        <TextBlock Text="Товаров" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="TotalProductsText" Text="0" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,15,15" Width="200">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="28"/>
                        <TextBlock Text="Заказов" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="TotalOrdersText" Text="0" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="20" Width="200">
                    <StackPanel>
                        <TextBlock Text="💰" FontSize="28"/>
                        <TextBlock Text="Выручка" FontSize="12" Foreground="#888888"/>
                        <TextBlock x:Name="TotalRevenueText" Text="0 ₽" FontSize="28" FontWeight="Bold" Foreground="#28A745"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Таблица топ товаров -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="15">
                <StackPanel>
                    <TextBlock Text="🏆 Топ-10 товаров" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="TopProductsGrid" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"/>
                            <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="300"/>
                            <DataGridTextColumn Header="Продано" Binding="{Binding TotalSold}" Width="100"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
