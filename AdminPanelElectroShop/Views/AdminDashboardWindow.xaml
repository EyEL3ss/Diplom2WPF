<Window x:Class="AdminPanelElectroShop.Views.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanelElectroShop.Views"
        mc:Ignorable="d"
        Title="AdminDashboardWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#1F6FEB">
            <Grid Margin="20,0">
                <TextBlock Text="Панель администратора" 
                           FontSize="18" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.FullName}" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <Button Content="Выйти" 
                            Click="LogoutButton_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковое меню -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Margin="0,0,0,-36">
                <StackPanel Margin="0,20">
                    <Button Content="📊 Статистика" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Statistics_Click"/>
                    <Button Content="👥 Пользователи" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Users_Click"/>
                    <Button Content="🧾 Заказы" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Orders_Click"/>
                    <Button Content="✅ Модерация товаров" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Moderation_Click" Width="188"/>
                    <Button Content="🛒 Товары (редакт.)" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Products_Click"/>
                    <Button Content="🏷️ Скидки" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="PromoCodes_Click"/>
                    <Button Content="📦 Склад" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Stock_Click"/>
                    <Button Content="🗄️ SQL-консоль" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="DatabaseConsole_Click"/>
                    <Button Content="Добавить новый товар" 
        Style="{StaticResource MenuButtonStyle}"
        Click="AddPage_Button"/>
                </StackPanel>
            </Border>

            <!-- Область контента -->
            <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="50,0,0,0"/>
        </Grid>
    </Grid>
</Window>
