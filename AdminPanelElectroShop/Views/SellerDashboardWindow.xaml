<Window x:Class="AdminPanelElectroShop.Views.SellerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanelElectroShop.Views"
        mc:Ignorable="d"
        Title="SellerDashboardWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#28A745">
            <Grid Margin="20,0">
                <TextBlock Text="Панель продавца" 
                           FontSize="18" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.FullName}" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <Button Content="Выйти" 
                            Click="LogoutButton_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковое меню продавца -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20">
                    <Button Content="📦 Мои товары" 
                            Style="{StaticResource MenuButtonStyle}"
                           />
                    <Button Content="➕ Добавить товар" 
                            Style="{StaticResource MenuButtonStyle}"
                          />
                    <Button Content="📋 Заказы" 
                            Style="{StaticResource MenuButtonStyle}"
                           />
                    <Button Content="💬 Обращения" 
                            Style="{StaticResource MenuButtonStyle}"
                        />
                    <Button Content="🏷️ Мои скидки" 
                            Style="{StaticResource MenuButtonStyle}"
                           />
                </StackPanel>
            </Border>

            <!-- Область контента -->
            <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
        </Grid>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="© 2024 Магазин электроники. Панель продавца." 
                       FontSize="11"
                       Foreground="#888888"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
