<Page x:Class="AdminPanelElectroShop.Views.OrdersManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="560" d:DesignWidth="1100"
      Title="OrdersManagementPage">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🧾 Управление заказами" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Margin="0,0,10,0" Padding="10" TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Content="+ Заказ" Width="100" Margin="0,0,10,0" Click="AddOrder_Click"/>
            <Button Grid.Column="2" Content="Обновить" Width="90" Margin="0,0,10,0" Click="Refresh_Click"/>
        </Grid>

        <!-- Панель редактирования заказа -->
        <Border x:Name="EditPanel" Grid.Row="2" Visibility="Collapsed" Background="#F8F9FA"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <WrapPanel>
                <TextBox x:Name="OrderNumberBox" Width="150" Margin="0,0,8,8" Padding="8" ToolTip="Номер заказа"/>
                <TextBox x:Name="UserIdBox" Width="90" Margin="0,0,8,8" Padding="8" ToolTip="ID пользователя"/>
                <TextBox x:Name="TotalAmountBox" Width="110" Margin="0,0,8,8" Padding="8" ToolTip="Сумма"/>
                <ComboBox x:Name="ResponsibleSellerCombo" Width="180" Margin="0,0,8,8"
                          DisplayMemberPath="FullName" SelectedValuePath="Id" ToolTip="Ответственный продавец"/>
                <ComboBox x:Name="DeliveryMethodBox" Width="135" Margin="0,0,8,8">
                    <ComboBoxItem Content="Самовывоз" Tag="pickup"/>
                    <ComboBoxItem Content="Доставка на дом" Tag="courier"/>
                </ComboBox>
                <TextBox x:Name="DeliveryAddressBox" Width="220" Margin="0,0,8,8" Padding="8" ToolTip="Адрес доставки"/>
                <DatePicker x:Name="DeliveryDatePicker" Width="140" Margin="0,0,8,8" ToolTip="Дата доставки"/>
                <TextBox x:Name="DeliveryTimeSlotBox" Width="130" Margin="0,0,8,8" Padding="8" ToolTip="Время доставки"/>
                <ComboBox x:Name="PaymentMethodBox" Width="120" Margin="0,0,8,8">
                    <ComboBoxItem Content="Карта" Tag="card"/>
                    <ComboBoxItem Content="Наличные" Tag="cash"/>
                    <ComboBoxItem Content="Онлайн" Tag="online"/>
                </ComboBox>
                <ComboBox x:Name="StatusBox" Width="110" Margin="0,0,8,8">
                    <ComboBoxItem Content="new"/>
                    <ComboBoxItem Content="processing"/>
                    <ComboBoxItem Content="delivering"/>
                    <ComboBoxItem Content="completed"/>
                    <ComboBoxItem Content="cancelled"/>
                </ComboBox>
                <ComboBox x:Name="PaymentStatusBox" Width="110" Margin="0,0,8,8">
                    <ComboBoxItem Content="pending"/>
                    <ComboBoxItem Content="paid"/>
                    <ComboBoxItem Content="failed"/>
                    <ComboBoxItem Content="refunded"/>
                </ComboBox>
                <TextBox x:Name="TrackingNumberBox" Width="150" Margin="0,0,8,8" Padding="8" ToolTip="Трек-номер"/>
                <Button Content="Сохранить" Width="90" Margin="0,0,8,8" Click="SaveOrder_Click" 
                        Background="#28A745" Foreground="White"/>
                <Button Content="Отмена" Width="90" Margin="0,0,8,8" Click="CancelEdit_Click"/>
            </WrapPanel>
        </Border>

        <!-- Таблица заказов -->
        <DataGrid x:Name="OrdersGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionChanged="OrdersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="130"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="150"/>
                <DataGridTextColumn Header="Ответственный" Binding="{Binding ResponsibleSellerName}" Width="150"/>
                <DataGridTextColumn Header="Товаров" Binding="{Binding ProductsCount}" Width="75"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N0} ₽}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentStatus}" Width="90"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏️" Width="35" Margin="0,0,5,0" Click="EditOrder_Click" 
                                        Background="#1F6FEB" Foreground="White"/>
                                <Button Content="×" Width="35" Margin="0,0,5,0" Click="CancelOrder_Click" 
                                        Background="#FFC107" Foreground="Black" ToolTip="Отменить заказ"/>
                                <Button Content="🗑️" Width="35" Click="DeleteOrder_Click" 
                                        Background="#DC3545" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,12,0,8">
            <TextBlock x:Name="OrderItemsTitleText" Text="Позиции заказа: не выбран"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="+ Добавить товар" Width="120" HorizontalAlignment="Right" DockPanel.Dock="Right"
                    Click="AddOrderItem_Click" Background="#28A745" Foreground="White"/>
        </DockPanel>

        <!-- Панель редактирования позиции заказа с выбором товара -->
        <Border x:Name="OrderItemEditPanel" Grid.Row="5" Visibility="Collapsed" Background="#F8F9FA"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel>
                <ComboBox x:Name="ItemProductCombo" Width="280" Margin="0,0,8,8"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          SelectionChanged="ItemProductCombo_SelectionChanged"
                          ToolTip="Выберите товар"/>
                <TextBox x:Name="ItemProductNameBox" Width="160" Margin="0,0,8,8" Padding="8" 
                         ToolTip="Название товара"/>
                <TextBox x:Name="ItemPriceBox" Width="100" Margin="0,0,8,8" Padding="8" 
                         ToolTip="Цена (с учётом скидки)"/>
                <TextBox x:Name="ItemQuantityBox" Width="80" Margin="0,0,8,8" Padding="8" 
                         ToolTip="Количество"/>
                <Button Content="Сохранить" Width="90" Margin="0,0,8,8" Click="SaveOrderItem_Click" 
                        Background="#28A745" Foreground="White"/>
                <Button Content="Отмена" Width="90" Margin="0,0,8,8" Click="CancelOrderItemEdit_Click"/>
            </WrapPanel>
        </Border>

        <!-- Таблица позиций заказа -->
        <DataGrid x:Name="OrderItemsGrid" Grid.Row="6" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="300"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding ProductPrice, StringFormat={}{0:N0} ₽}" Width="100"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:N0} ₽}" Width="100"/>
                <DataGridTemplateColumn Header="Действия" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏️" Width="35" Margin="0,0,5,0" Click="EditOrderItem_Click" 
                                        Background="#1F6FEB" Foreground="White"/>
                                <Button Content="🗑️" Width="35" Click="DeleteOrderItem_Click" 
                                        Background="#DC3545" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
