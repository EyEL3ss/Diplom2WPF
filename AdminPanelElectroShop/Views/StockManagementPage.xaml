<Page x:Class="AdminPanelElectroShop.Views.StockManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdminPanelElectroShop.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StockManagementPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📦 Управление складом" 
                   FontSize="24" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Поиск -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Margin="0,0,10,0" Padding="10"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Content="Поиск" Width="80"/>
        </Grid>

        <!-- Панель редактирования количества -->
        <Border x:Name="EditPanel" Grid.Row="2" 
                Visibility="Collapsed" Background="#F8F9FA" 
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8"
                Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Редактирование количества" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Новое количество:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="QuantityBox" Width="100" Margin="0,0,10,0" Padding="8"/>
                    <TextBlock Text="Дата поступления:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="ReceivedDatePicker" Width="140" Margin="0,0,10,0"/>
                    <TextBlock Text="Номенклатура:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NomenclatureBox" Width="220" Margin="0,0,10,0" Padding="8"/>
                    <Button Content="Сохранить" Width="80" Margin="0,0,10,0" 
                            Click="SaveStock_Click" Background="#28A745" Foreground="White"/>
                    <Button Content="Отмена" Width="80" Click="CancelEdit_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Таблица товаров -->
        <DataGrid x:Name="ProductsGrid" Grid.Row="3" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="250"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="120"/>
                <DataGridTextColumn Header="Продавец" Binding="{Binding SellerName}" Width="150"/>
                <DataGridTextColumn Header="В наличии" Binding="{Binding StockQuantity}" Width="100"/>
                <DataGridTextColumn Header="Дата поступления" Binding="{Binding ReceivedAtText}" Width="130"/>
                <DataGridTextColumn Header="Номенклатура" Binding="{Binding Nomenclature}" Width="220"/>
                <DataGridTemplateColumn Header="Статус" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding InStock, Converter={StaticResource BoolToStatusConverter}}"
                                       Foreground="{Binding InStock, Converter={StaticResource BoolToColorConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Действия" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✏️ Редактировать" 
                                    Click="EditStock_Click" 
                                    Background="#1F6FEB" Foreground="White"
                                    Padding="8,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Хит продаж" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsHit}" 
                      Checked="HitCheckBox_Checked"
                      Unchecked="HitCheckBox_Unchecked"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
