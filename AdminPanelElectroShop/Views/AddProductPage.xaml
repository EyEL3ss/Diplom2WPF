<Page x:Class="AdminPanelElectroShop.Views.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdminPanelElectroShop.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddProductPage">
    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="➕ Добавление нового товара" 
                       FontSize="24" FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Форма добавления товара -->
            <Grid Grid.Row="1" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Левая колонка -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Название товара *" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" Margin="0,0,20,15" Padding="10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Бренд" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="BrandBox" Grid.Row="3" Grid.Column="0" Margin="0,0,20,15" Padding="10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Категория *" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CategoryCombo" Grid.Row="5" Grid.Column="0" Margin="0,0,20,15" Padding="8"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Цена *" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="PriceBox" Grid.Row="7" Grid.Column="0" Margin="0,0,20,15" Padding="10"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Количество на складе" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="StockBox" Grid.Row="9" Grid.Column="0" Margin="0,0,20,15" Padding="10"/>

                <!-- Правая колонка -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Краткое описание" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ShortDescBox" Grid.Row="1" Grid.Column="1" Height="60" Margin="0,0,0,15" 
                         TextWrapping="Wrap" AcceptsReturn="True" Padding="10"/>

                <TextBlock Grid.Row="2" Grid.Column="1" Text="Полное описание" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="FullDescBox" Grid.Row="3" Grid.Column="1" Height="100" Margin="0,0,0,15" 
                         TextWrapping="Wrap" AcceptsReturn="True" Padding="10" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="4" Grid.Column="1" Text="Характеристики (через запятую)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="SpecsBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,15" Padding="10"/>

                <TextBlock Grid.Row="6" Grid.Column="1" Text="Ссылка на изображение" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ImageUrlBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,15" Padding="10"/>

                <!-- Кнопки -->
                <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="35"
                            Margin="0,0,10,0" Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="Сохранить" Width="100" Height="35"
                            Background="#1F6FEB" Foreground="White" Click="SaveButton_Click"/>
                </StackPanel>

                <!-- Статус -->
                <TextBlock x:Name="StatusText" Grid.Row="9" Grid.ColumnSpan="2" 
                           Foreground="#28A745" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
